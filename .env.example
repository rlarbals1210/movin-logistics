# 실제 값은 .env 에 넣는다. .env 는 gitignore 되어 있고 커밋되지 않는다.
# 이 파일은 "무엇을 채워야 하는지" 만 알려준다 — 값을 여기 적지 마라.

# Gemini 한 줄 코멘트 (api/insights.ts)
GEMINI_API_KEY=
GEMINI_MODEL=

# 카카오맵 — 반드시 REST API 키(JavaScript 키 아님). backend/app/kakao.py 가 서버에서
# 직접 호출한다. 콘솔: https://developers.kakao.com/console/app → 앱 키
KAKAOMAP_REST_API_KEY=

# 프론트가 부를 백엔드 주소. 비워두면 vite dev proxy 가 127.0.0.1:8000 으로 넘긴다.
# 배포에서는 Railway 주소를 넣는다.
VITE_API_BASE=
